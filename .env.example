# Copy this file to .env. Never commit .env or share ODOO_API_KEY in chat.
ODOO_URL=https://brightloop-software.odoo.com
ODOO_DATABASE=brightloop-software
ODOO_API_KEY=

# Optional protection for the REST API used by teammates. Set a long random value
# before deploying or binding HOST to 0.0.0.0.
APP_API_TOKEN=
HOST=127.0.0.1
PORT=8000
CURRENCY=INR
CORS_ORIGIN=*
